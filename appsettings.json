{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER;Database=InterviewPrepDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Key": "<YOUR_JWT_SECRET_KEY>",
    "Issuer": "InterviewPrepAPI",
    "Audience": "InterviewPrepUsers",
    "DurationInMinutes": 120
  },
  "AzureOpenAI": {
    "Endpoint": "<AZURE_OPENAI_ENDPOINT>",
    "ApiKey": "<AZURE_OPENAI_API_KEY>",
    "DeploymentName": "gpt-5-mini"
  },
  "AllowedHosts": "*"
}